def extract_pages(uploaded_file):
    pages = []
    if uploaded_file.name.endswith(".pdf"):
        reader = pypdf.PdfReader(uploaded_file)
        for page in reader.pages:
            pages.append(page.extract_text() or "")
    elif uploaded_file.name.endswith(".docx"):
        doc = docx.Document(uploaded_file)
        full_text = "\n".join([p.text for p in doc.paragraphs])
        words = full_text.split()
        chunk_size = 500
        for i in range(0, len(words), chunk_size):
            pages.append(" ".join(words[i:i+chunk_size]))
    return pages

async def generate_speech(script, output_file="podcast.mp3"):
    lines = script.split("\n")
    temp_files = []
    for idx, line in enumerate(lines):
        line = line.strip()
        if not line:
            continue
        voice = None
        text_to_speak = ""
        if line.startswith("[آرش]:") or line.startswith("آرش:"):
            voice = "fa-IR-FaridNeural"
            text_to_speak = line.replace("[آرش]:", "").replace("آرش:", "").strip()
        elif line.startswith("[سارا]:") or line.startswith("سارا:"):
            voice = "fa-IR-DilaraNeural"
            text_to_speak = line.replace("[سارا]:", "").replace("سارا:", "").strip()
            
        if voice and text_to_speak:
            temp_path = f"temp_{idx}.mp3"
            communicate = edge_tts.Communicate(text_to_speak, voice)
            await communicate.save(temp_path)
            temp_files.append(temp_path)
            
    if temp_files:
        with open(output_file, "wb") as outfile:
            for f in temp_files:
                with open(f, "rb") as infile:
                    outfile.write(infile.read())
                os.remove(f)
        return output_file
    return None

